# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Variable files containing secrets
# *.tfvars
*.tfvars.json

# Allow example variable files
!*.example.tfvars

# Terraform lock file
# Usually you SHOULD commit this file
# .terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Environment / secret files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/

# Logs
*.log.terraform/
